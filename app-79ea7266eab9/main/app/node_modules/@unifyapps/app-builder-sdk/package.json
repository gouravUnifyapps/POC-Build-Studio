{
  "name": "@unifyapps/app-builder-sdk",
  "version": "0.6.0",
  "description": "React hooks and a copilot for UnifyApps app-builder apps — objects, workflows, auth, uploads, and chat against the current origin's session.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unify-apps/www.git",
    "directory": "packages/app-builder-sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks/object": {
      "types": "./dist/hooks/object.d.ts",
      "import": "./dist/hooks/object.js"
    },
    "./hooks/workflow": {
      "types": "./dist/hooks/workflow.d.ts",
      "import": "./dist/hooks/workflow.js"
    },
    "./hooks/auth": {
      "types": "./dist/hooks/auth.d.ts",
      "import": "./dist/hooks/auth.js"
    },
    "./hooks/user": {
      "types": "./dist/hooks/user.d.ts",
      "import": "./dist/hooks/user.js"
    },
    "./hooks/permissions": {
      "types": "./dist/hooks/permissions.d.ts",
      "import": "./dist/hooks/permissions.js"
    },
    "./hooks/upload": {
      "types": "./dist/hooks/upload.d.ts",
      "import": "./dist/hooks/upload.js"
    },
    "./hooks/copilot": {
      "types": "./dist/hooks/copilot.d.ts",
      "import": "./dist/hooks/copilot.js"
    },
    "./copilot": {
      "types": "./dist/copilot.d.ts",
      "import": "./dist/copilot.js"
    },
    "./copilot.css": "./dist/copilot.css",
    "./artifact": {
      "types": "./dist/artifact.d.ts",
      "import": "./dist/artifact.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ts": "tsgo --incremental --noEmit",
    "test": "jest",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "build:cdn": "NODE_OPTIONS='--max-old-space-size=8192' vite build --config vite.config.cdn.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@unifyapps/analytics-web": "^0.11.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.4",
    "@typescript/native-preview": "catalog:",
    "@unifyapps/blocks": "workspace:*",
    "@unifyapps/carbon": "workspace:*",
    "@unifyapps/defs": "workspace:*",
    "@unifyapps/editor": "workspace:*",
    "@unifyapps/form": "workspace:*",
    "@unifyapps/hooks": "workspace:*",
    "@unifyapps/i18n": "workspace:*",
    "@unifyapps/icons": "workspace:*",
    "@unifyapps/lint-config": "workspace:*",
    "@unifyapps/neon": "workspace:*",
    "@unifyapps/network": "workspace:*",
    "@unifyapps/style": "workspace:*",
    "@unifyapps/table": "workspace:*",
    "@unifyapps/ui": "workspace:*",
    "@uppy/core": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "jest": "^29.7.0",
    "react": "catalog:",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-preserve-directives": "^1.1.3",
    "tailwindcss": "^3.4.17",
    "tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  }
}
